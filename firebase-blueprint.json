{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace owner profile and sandbox preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "organization", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sandbox B2B receivable invoice belonging to an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "customer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["KES", "USD", "USDC"]
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["open", "partially_settled", "settled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "reference", "customer", "description", "amount", "currency", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "Sandbox settlement instruction linked to an invoice and verified by backend attestation.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "sourceCurrency": {
          "type": "string",
          "enum": ["KES", "USD", "USDC"]
        },
        "destinationCurrency": {
          "type": "string",
          "enum": ["KES", "USD", "USDC"]
        },
        "destination": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "rail": {
          "type": "string",
          "enum": ["mpesa_sandbox", "bank_sandbox", "stablecoin_sandbox"]
        },
        "status": {
          "type": "string",
          "enum": ["pending_confirmation", "processing", "completed", "failed"]
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "confirmationToken": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "attestationHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "invoiceId",
        "amount",
        "sourceCurrency",
        "destinationCurrency",
        "destination",
        "rail",
        "status",
        "idempotencyKey",
        "note",
        "confirmationToken",
        "attestationHash",
        "createdAt",
        "updatedAt"
      ]
    },
    "Beneficiary": {
      "title": "Beneficiary",
      "description": "Saved payout recipient directory entry scoped to the user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "rail": {
          "type": "string",
          "enum": ["M-Pesa", "Bank transfer", "USDC wallet"]
        },
        "destination": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "country", "rail", "destination", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security audit log entry for verified workspace actions.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "attestationHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "action", "targetId", "attestationHash", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user workspace profile containing PII (email) and settings; readable and writable only by the verified owner."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "User-scoped sandbox invoices."
    },
    "/users/{userId}/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "User-scoped sandbox settlement instructions linked to an existing invoice."
    },
    "/users/{userId}/beneficiaries/{beneficiaryId}": {
      "schema": { "$ref": "#/entities/Beneficiary" },
      "description": "User-scoped saved payout beneficiaries."
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only security audit log entries for workspace actions."
    }
  }
}
